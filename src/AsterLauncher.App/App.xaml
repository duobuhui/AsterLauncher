<Application
    x:Class="AsterLauncher.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0C12" />
                    <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="#0E1119" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#11151F" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#151A25" />
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1C2230" />
                    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#E6131721" />
                    <SolidColorBrush x:Key="ChipBrush" Color="#D9212733" />
                    <SolidColorBrush x:Key="SubtleStrokeBrush" Color="#2FFFFFFF" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#AEB6CA" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3F8975FF" />
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#E0DBFF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#55D6A0" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F4C768" />
                    <AcrylicBrush x:Key="FrostedRailBrush" TintColor="#111827" TintOpacity="0.44" TintLuminosityOpacity="0.58" FallbackColor="#D31A2535" />
                    <AcrylicBrush x:Key="FrostedPanelBrush" TintColor="#182436" TintOpacity="0.38" TintLuminosityOpacity="0.58" FallbackColor="#D8243041" />
                    <AcrylicBrush x:Key="HeroGlassBrush" TintColor="#111C2B" TintOpacity="0.32" TintLuminosityOpacity="0.58" FallbackColor="#C91B2839" />
                    <SolidColorBrush x:Key="FeaturePageScrimBrush" Color="#5C08101D" />
                    <AcrylicBrush x:Key="LaunchPanelBrush" TintColor="#101924" TintOpacity="0.82" TintLuminosityOpacity="0.08" FallbackColor="#E0182432" />
                    <SolidColorBrush x:Key="GlassTileBrush" Color="#36DDE8FF" />
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A0FFFFFF" Offset="0" /><GradientStop Color="#44D9E9FF" Offset="0.46" /><GradientStop Color="#1D9FB8E9" Offset="1" /></LinearGradientBrush>
                    <SolidColorBrush x:Key="PoolCardOverlayBrush" Color="#96162534" />
                    <SolidColorBrush x:Key="GlassTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GlassMutedTextBrush" Color="#EEF1F7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F9" />
                    <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="#FAFAFC" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#F0F1F6" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E9EBF2" />
                    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#EFFFFFFF" />
                    <SolidColorBrush x:Key="ChipBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="SubtleStrokeBrush" Color="#1F111827" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#596174" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#288975FF" />
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#5845C7" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#147A50" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#8B5E00" />
                    <AcrylicBrush x:Key="FrostedRailBrush" TintColor="#F2F3F8" TintOpacity="0.72" TintLuminosityOpacity="0.58" FallbackColor="#E9EEF0F6" />
                    <AcrylicBrush x:Key="FrostedPanelBrush" TintColor="#F4F5FA" TintOpacity="0.72" TintLuminosityOpacity="0.58" FallbackColor="#EAF3F4F8" />
                    <AcrylicBrush x:Key="HeroGlassBrush" TintColor="#F0F2F8" TintOpacity="0.72" TintLuminosityOpacity="0.58" FallbackColor="#E6EEF0F6" />
                    <SolidColorBrush x:Key="FeaturePageScrimBrush" Color="#36E8EBF3" />
                    <AcrylicBrush x:Key="LaunchPanelBrush" TintColor="#F6F6FA" TintOpacity="0.82" TintLuminosityOpacity="0.08" FallbackColor="#F2F0F2F7" />
                    <SolidColorBrush x:Key="GlassTileBrush" Color="#80FFFFFF" />
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A0FFFFFF" Offset="0" /><GradientStop Color="#44D9E9FF" Offset="0.46" /><GradientStop Color="#1D9FB8E9" Offset="1" /></LinearGradientBrush>
                    <SolidColorBrush x:Key="PoolCardOverlayBrush" Color="#ADF0F2F7" />
                    <SolidColorBrush x:Key="GlassTextBrush" Color="#202332" />
                    <SolidColorBrush x:Key="GlassMutedTextBrush" Color="#444C60" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="TextControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
            <SolidColorBrush x:Key="PageTitleBrush" Color="#C8BFFF" />
            <SolidColorBrush x:Key="LaunchButtonBrush" Color="#8975FF" />
            <SolidColorBrush x:Key="LaunchButtonTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ThemeGlassTintBrush" Color="#991B173A" />
            <SolidColorBrush x:Key="ThemeTextBackingBrush" Color="#664A3C88" />
            <SolidColorBrush x:Key="ThemeAccentBrush" Color="#A797FF" />
            <SolidColorBrush x:Key="ThemeAccentSoftBrush" Color="#558975FF" />
            <SolidColorBrush x:Key="ThemeStrokeBrush" Color="#889E8BFF" />
            <!-- Shared control colors stay on the app palette, including hover and checked states. -->
            <SolidColorBrush x:Key="ControlStrokeBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ControlDisabledBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ControlDisabledTextBrush" Color="#77FFFFFF" />
            <SolidColorBrush x:Key="LibraryRowBrush" Color="#16FFFFFF" />
            <StaticResource x:Key="ButtonBackground" ResourceKey="ControlSurfaceBrush" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlHoverBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlPressedBrush" />
            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ControlDisabledBrush" />
            <StaticResource x:Key="ButtonForeground" ResourceKey="GlassTextBrush" />
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="GlassTextBrush" />
            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="GlassTextBrush" />
            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="ControlDisabledTextBrush" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlStrokeBrush" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ThemeStrokeBrush" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlStrokeBrush" />
            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="ControlDisabledBrush" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="LaunchButtonBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="LaunchButtonBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="ThemeAccentSoftBrush" />
            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="ControlDisabledBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="LaunchButtonTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="LaunchButtonTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="GlassTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="ControlDisabledTextBrush" />
            <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="ThemeStrokeBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="ThemeStrokeBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="ThemeStrokeBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushDisabled" ResourceKey="ControlDisabledBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="ControlDisabledBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="ControlDisabledBrush" />
            <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="ControlDisabledTextBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="ControlDisabledTextBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="ControlStrokeBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="ThemeStrokeBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="ControlStrokeBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="ControlDisabledBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="ControlDisabledBrush" />
            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="ControlSurfaceBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="ControlHoverBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="ControlPressedBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ThemeAccentSoftBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ThemeAccentSoftBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ThemeAccentSoftBrush" />
            <StaticResource x:Key="ToggleButtonForeground" ResourceKey="GlassTextBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="GlassTextBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="GlassTextBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="PageTitleBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="PageTitleBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="PageTitleBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ThemeStrokeBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ThemeStrokeBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ThemeStrokeBrush" />
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="LaunchButtonBrush" />
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="LaunchButtonBrush" />
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="ThemeAccentSoftBrush" />
            <StaticResource x:Key="AccentTextFillColorPrimaryBrush" ResourceKey="ThemeAccentBrush" />
            <StaticResource x:Key="AccentTextFillColorSecondaryBrush" ResourceKey="ThemeAccentBrush" />
            <StaticResource x:Key="FocusVisualPrimaryBrush" ResourceKey="ThemeAccentBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="LaunchButtonBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="LaunchButtonBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="ThemeAccentSoftBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="ThemeStrokeBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="ThemeStrokeBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="LaunchButtonTextBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="LaunchButtonTextBrush" />
            <StaticResource x:Key="ProgressBarForeground" ResourceKey="ThemeAccentBrush" />
            <StaticResource x:Key="ProgressBarForegroundThemeBrush" ResourceKey="ThemeAccentBrush" />
            <StaticResource x:Key="ProgressBarIndeterminateForegroundThemeBrush" ResourceKey="ThemeAccentBrush" />
            <!-- Keep native templates and their keyboard/focus/disabled states. -->
            <Style x:Key="ThemeSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource GlassTextBrush}" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource ThemeSecondaryButtonStyle}" />
            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemeSecondaryButtonStyle}" />
            <Style x:Key="ThemePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="ToggleButton">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource FrostedPanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="CommunitySurfaceStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="InsetSurfaceBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="CompactBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource GlassTextBrush}" />
            </Style>
            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource GlassTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource GlassMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="CompactBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="LaunchButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemePrimaryButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource LaunchButtonBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource LaunchButtonTextBrush}" />
                <Setter Property="MinWidth" Value="190" />
                <Setter Property="MinHeight" Value="58" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="FloatingButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemeSecondaryButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource FloatingButtonStyle}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="CompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource FloatingButtonStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Width" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>
            <Style x:Key="ThemeActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemeSecondaryButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource ThemeAccentSoftBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PageTitleBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ThemeStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SecondaryNavButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemeSecondaryButtonStyle}">
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
