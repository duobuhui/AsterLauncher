<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AsterLauncher</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AsterLauncher.Core\AsterLauncher.Core.csproj" />
    <ProjectReference Include="..\AsterLauncher.Infrastructure\AsterLauncher.Infrastructure.csproj" />
    <ProjectReference Include="..\AsterLauncher.Tray\AsterLauncher.Tray.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Games\**\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Services\ApplyUpdate.ps1" LogicalName="AsterLauncher.ApplyUpdate.ps1" />
  </ItemGroup>
</Project>
