<Window
    x:Class="AsterLauncher.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AsterLauncher">
    <Grid x:Name="RootGrid" Background="#101824" Loaded="RootGrid_OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="WallpaperHost" Grid.RowSpan="2" IsHitTestVisible="False" />
        <Grid x:Name="GuideBackdrop" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#12172C" Offset="0" />
                    <GradientStop Color="#1A2441" Offset="0.5" />
                    <GradientStop Color="#0B1627" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-290,-150,0" Fill="#204F65B7" />
            <Ellipse Width="390" Height="390" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-170,0,0,-210" Fill="#2033A59F" />
        </Grid>
        <Border Grid.RowSpan="2" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1806090E" Offset="0" />
                    <GradientStop Color="#0006090E" Offset="0.54" />
                    <GradientStop Color="#2406090E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Border Width="22" Height="22" CornerRadius="7" Background="{ThemeResource LaunchButtonBrush}">
                    <TextBlock Text="✦" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource LaunchButtonTextBrush}" FontSize="12" />
                </Border>
                <TextBlock Text="ASTER LAUNCHER" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" CharacterSpacing="120" Foreground="White" />
            </StackPanel>
        </Grid>
        <Border x:Name="WorkspaceScrim" Grid.Row="0" Background="{ThemeResource FeaturePageScrimBrush}" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

        <Frame x:Name="ContentFrame" Grid.Row="1" Background="Transparent" IsNavigationStackEnabled="False" />
    </Grid>
</Window>
