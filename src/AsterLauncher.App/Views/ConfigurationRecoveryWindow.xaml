<Window
    x:Class="AsterLauncher.App.Views.ConfigurationRecoveryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AsterLauncher · 配置读取失败">
    <Grid Padding="24" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="配置未能读取，原文件已保留" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock x:Name="ReasonText" TextWrapping="Wrap" />
                <TextBlock x:Name="PathText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                <TextBlock Text="修复或恢复配置后，重新打开启动器即可。此时不会进入欢迎页或用默认设置覆盖原记录。" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="RestoreButton" Content="恢复配置备份" Click="RestoreBackup_OnClick" /><Button Content="打开数据目录" Click="OpenDataDirectory_OnClick" />
            <Button Content="关闭启动器" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>