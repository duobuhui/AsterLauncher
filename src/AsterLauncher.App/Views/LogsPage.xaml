<Page
    x:Class="AsterLauncher.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:AsterLauncher.Infrastructure"
    Loaded="Page_OnLoaded">
    <Grid Padding="{StaticResource FeaturePagePadding}">
        <Border Style="{StaticResource CommunitySurfaceStyle}" AutomationProperties.AutomationId="LogsSurface">
        <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding LogPath}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
            <Button Grid.Column="1" Content="刷新" VerticalAlignment="Center" Click="Refresh_OnClick" />
        </Grid>
        <ListView Grid.Row="1" ItemsSource="{Binding Entries}" SelectionMode="None" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="infra:LauncherLogEntry">
                    <Border BorderBrush="{ThemeResource SubtleStrokeBrush}" BorderThickness="0,0,0,1" Padding="8,9">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Timestamp}" Foreground="{ThemeResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Level}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Category}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Message}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </Grid>
        </Border>
    </Grid>
</Page>
