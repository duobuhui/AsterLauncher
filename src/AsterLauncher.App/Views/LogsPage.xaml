<Page
    x:Class="AsterLauncher.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:AsterLauncher.Infrastructure"
    Loaded="Page_OnLoaded">
    <Grid Padding="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="2"><TextBlock Text="日志" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" /><TextBlock Text="扫描 · 配置 · 启动" FontSize="13" Foreground="{ThemeResource GlassMutedTextBrush}" /></StackPanel>
            <Button Content="刷新" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_OnClick" />
        </Grid>
        <Border Grid.Row="1" Margin="0,14,0,10" Background="{ThemeResource HeroGlassBrush}" CornerRadius="12" Padding="10,6"><TextBlock Text="{Binding LogPath}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" /></Border>
        <ListView Grid.Row="2" ItemsSource="{Binding Entries}" SelectionMode="None" Background="{ThemeResource FrostedPanelBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="infra:LauncherLogEntry">
                    <Border BorderBrush="#32DDEBFF" BorderThickness="0,0,0,1" Padding="8,9">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Timestamp}" Foreground="{ThemeResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Level}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Category}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Message}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
