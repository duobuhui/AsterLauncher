<Page
    x:Class="AsterLauncher.App.Views.GameSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28,24" Spacing="16" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="游戏设置" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" />
                <TextBlock Text="路径与主视觉" FontSize="13" Foreground="{ThemeResource GlassMutedTextBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                <Grid ColumnSpacing="18" RowSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="游戏" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="GameNameText" Grid.Column="1" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="游戏 EXE" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="ExecutablePathBox" IsReadOnly="True" PlaceholderText="尚未指定" />
                        <Button Grid.Column="1" Content="选择 EXE" Click="SelectExecutable_OnClick" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="显示名称" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox x:Name="DisplayNameBox" Grid.Row="2" Grid.Column="1" />
                    <TextBlock Grid.Row="3" Text="发行商" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox x:Name="PublisherBox" Grid.Row="3" Grid.Column="1" />
                    <TextBlock Grid.Row="4" Text="主视觉图片" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="ArtworkPathBox" IsReadOnly="True" PlaceholderText="未设置时使用原创渐变占位" />
                        <Button Grid.Column="1" Content="选择图片" Click="SelectArtwork_OnClick" />
                    </Grid>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="OfficialDownloadButton" Content="打开官方下载" Click="OpenOfficialDownload_OnClick" />
                        <Button Content="保存游戏设置" Style="{StaticResource AccentButtonStyle}" Click="Save_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="ResultInfo" IsOpen="False" IsClosable="True" />
            <TextBlock x:Name="DownloadDescriptionText" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
