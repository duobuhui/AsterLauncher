<Page
    x:Class="AsterLauncher.App.Views.GameSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:AsterLauncher.Infrastructure"
    Loaded="Page_OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28,24" Spacing="16" HorizontalAlignment="Stretch">


            <TextBlock x:Name="ExternalEntryInfo" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
            <Border x:Name="ServerPanel" Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="安装服务器" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="选择已有游戏目录所属的服务器。仅登记安装信息，不修改游戏文件；切换到另一服请使用游戏图标的右键菜单。" FontSize="13" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" />
                    <TextBox x:Name="ServerExecutableBox" IsReadOnly="True" AutomationProperties.Name="服务器安装 EXE" />
                    <StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="ServerBox" Width="150" AutomationProperties.Name="安装服务器"><ComboBoxItem Content="请选择" /><ComboBoxItem Content="官服" /><ComboBoxItem Content="哔哩哔哩服" /></ComboBox><Button Content="选择 EXE" Click="SelectServerExecutable_OnClick" /><Button Content="确认服务器" Style="{StaticResource ThemePrimaryButtonStyle}" Click="ConfirmServer_OnClick" /></StackPanel>
                </StackPanel>
            </Border>
            <Border Visibility="{x:Bind EndfieldSettings.Visibility, Mode=OneWay}" Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                <StackPanel Spacing="12">
                    <Grid><TextBlock Text="终末地画面设置" FontSize="20" FontWeight="SemiBold" /><Button Content="重新读取" HorizontalAlignment="Right" Click="ReadDisplay_OnClick" /></Grid>
                    <TextBlock Text="两服共用。关闭游戏后修改，下次启动生效。" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <NumberBox Header="宽度" Value="{x:Bind EndfieldSettings.Width, Mode=TwoWay}" Minimum="640" Maximum="16384" Width="140" SpinButtonPlacementMode="Compact" IsEnabled="{x:Bind EndfieldSettings.CanEdit, Mode=OneWay}" />
                        <NumberBox Header="高度" Value="{x:Bind EndfieldSettings.Height, Mode=TwoWay}" Minimum="480" Maximum="16384" Width="140" SpinButtonPlacementMode="Compact" IsEnabled="{x:Bind EndfieldSettings.CanEdit, Mode=OneWay}" />
                        <ToggleSwitch Header="窗口模式" OnContent="全屏窗口" OffContent="窗口" IsOn="{x:Bind EndfieldSettings.Fullscreen, Mode=TwoWay}" IsEnabled="{x:Bind EndfieldSettings.CanEdit, Mode=OneWay}" ><ToggleSwitch.Resources><StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="LaunchButtonBrush" /><StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="LaunchButtonBrush" /><StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="ThemeAccentSoftBrush" /></ToggleSwitch.Resources></ToggleSwitch>
                        <Button Content="保存分辨率" VerticalAlignment="Bottom" Tag="resolution" Style="{StaticResource ThemePrimaryButtonStyle}" Click="DisplayAction_OnClick" IsEnabled="{x:Bind EndfieldSettings.CanEdit, Mode=OneWay}" />
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource GlassEdgeBrush}" />
                    <TextBlock Text="画质方案" FontWeight="SemiBold" />
                    <TextBlock Text="先在游戏内调整画质，退出后重新读取并保存到方案。方案保留帧率、纹理、阴影、抗锯齿等游戏已有设置，不改变分辨率。更新游戏后如选项发生变化，请重新保存方案。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox Value="{x:Bind EndfieldSettings.PresetSlot, Mode=TwoWay}" Minimum="1" Maximum="3" Width="110" SpinButtonPlacementMode="Inline" AutomationProperties.Name="画质方案编号" />
                        <Button Content="保存当前画质" Tag="save-quality" Click="DisplayAction_OnClick" IsEnabled="{x:Bind EndfieldSettings.CanEdit, Mode=OneWay}" />
                        <Button Content="应用方案" Tag="apply-quality" Click="DisplayAction_OnClick" IsEnabled="{x:Bind EndfieldSettings.CanEdit, Mode=OneWay}" />
                        <Button Content="撤销上次修改" Tag="restore" Click="DisplayAction_OnClick" IsEnabled="{x:Bind EndfieldSettings.CanEdit, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind EndfieldSettings.Status, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                </StackPanel>
            </Border>
            <Border Visibility="{x:Bind EndfieldSettings.Visibility, Mode=OneWay}" Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                <StackPanel Spacing="10">
                    <Grid><TextBlock Text="游戏照片" FontSize="20" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button Content="选择文件夹" Click="SelectPhotoDirectory_OnClick" /><Button Content="打开文件夹" Click="OpenPhotoDirectory_OnClick" /><Button Content="刷新" Click="ReadDisplay_OnClick" /></StackPanel></Grid>
                    <TextBlock Text="{x:Bind EndfieldSettings.PhotoDirectory, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" />
                    <TextBlock Text="点击照片在系统图片查看器中打开。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                    <TextBlock Text="{x:Bind EndfieldSettings.PhotoSummary, Mode=OneWay}" FontSize="13" />
                    <GridView MaxHeight="400" ItemsSource="{x:Bind EndfieldSettings.Photos, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="Photo_OnClick" SelectionMode="None" HorizontalAlignment="Stretch">
                        <GridView.ItemTemplate><DataTemplate x:DataType="infra:EndfieldPhoto"><StackPanel Width="220" Spacing="5" Margin="0,0,8,8"><Border CornerRadius="8" Background="{ThemeResource HeroGlassBrush}"><Image Height="124" Stretch="Uniform" Loaded="PhotoImage_OnLoaded" Unloaded="PhotoImage_OnUnloaded" /></Border><TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind DateText}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" /></StackPanel></DataTemplate></GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>
            <Expander x:Name="PresentationExpander" Header="游戏信息与背景" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Border Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                <Grid ColumnSpacing="18" RowSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="游戏" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="GameNameText" Grid.Column="1" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="游戏 EXE" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="ExecutablePathBox" IsReadOnly="True" PlaceholderText="尚未指定" />
                        <Button Grid.Column="1" Content="选择 EXE" Click="SelectExecutable_OnClick" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="显示名称" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox x:Name="DisplayNameBox" Grid.Row="2" Grid.Column="1" />
                    <TextBlock Grid.Row="3" Text="发行商" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox x:Name="PublisherBox" Grid.Row="3" Grid.Column="1" />
                    <TextBlock Grid.Row="4" Text="背景图片" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="ArtworkPathBox" IsReadOnly="True" PlaceholderText="未选择时使用官方壁纸或内置背景" />
                        <Button Grid.Column="1" Content="选择图片" Click="SelectArtwork_OnClick" />
                    </Grid>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="OfficialDownloadButton" Content="打开官方下载" Click="OpenOfficialDownload_OnClick" />
                        <Button Content="保存游戏设置" Style="{StaticResource ThemePrimaryButtonStyle}" Click="Save_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>
            </Expander>
            <InfoBar x:Name="ResultInfo" IsOpen="False" IsClosable="True" />
            <TextBlock x:Name="DownloadDescriptionText" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
