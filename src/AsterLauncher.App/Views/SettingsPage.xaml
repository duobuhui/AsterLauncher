<Page x:Class="AsterLauncher.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28,24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="2"><TextBlock Text="启动器设置" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" /><TextBlock Text="应用信息、外观、窗口与游戏路径" Foreground="{ThemeResource GlassMutedTextBrush}" FontSize="13" /></StackPanel>
        <TabView Grid.Row="1" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
            <TabViewItem IsClosable="False" AutomationProperties.Name="首页"><TabViewItem.Header><TextBlock Text="首页" Foreground="{ThemeResource PageTitleBrush}" /></TabViewItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Padding="0,16,16,16" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="18" VerticalAlignment="Stretch">
                        <StackPanel Spacing="8"><TextBlock Text="AsterLauncher" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" /><TextBlock Text="独立开发的游戏启动器" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" /><TextBlock x:Name="VersionText" FontSize="14" /><TextBlock Text=".NET 10 · Windows App SDK 2.4 · WinUI 3" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="14">
                        <Border Background="{ThemeResource FrostedPanelBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel Spacing="8"><TextBlock Text="项目主页" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="github.com/duobuhui/AsterLauncher" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" /><Button Content="打开 GitHub" Click="OpenRepository_OnClick" /></StackPanel></Border>
                        <Border Background="{ThemeResource FrostedPanelBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel Spacing="8"><TextBlock Text="启动器更新" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="UpdateStatusText" Text="可从 GitHub Releases 检查新版本" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_OnClick" /><Button x:Name="InstallUpdateButton" Content="下载并安装" IsEnabled="False" Style="{StaticResource ThemeActionButtonStyle}" Click="InstallUpdate_OnClick" /></StackPanel></StackPanel></Border>
                    </StackPanel>
                </Grid></ScrollViewer>
            </TabViewItem>
            <TabViewItem IsClosable="False" AutomationProperties.Name="外观"><TabViewItem.Header><TextBlock Text="外观" Foreground="{ThemeResource PageTitleBrush}" /></TabViewItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Padding="0,16,16,16" Spacing="14">
                    <Border Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="应用主题" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="主题色用于按钮、玻璃遮罩和页面标题" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" /></StackPanel>
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="220" VerticalAlignment="Center" AutomationProperties.Name="应用主题" SelectionChanged="ThemeBox_OnSelectionChanged">
                                <ComboBoxItem Content="跟随 Windows" Tag="System" /><ComboBoxItem Content="深色" Tag="Dark" /><ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="提丰紫" Tag="TyphonPurple" /><ComboBoxItem Content="爱莉粉" Tag="ElysiaPink" /><ComboBoxItem Content="派蒙白" Tag="PaimonWhite" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>
            <TabViewItem IsClosable="False" AutomationProperties.Name="窗口与路径"><TabViewItem.Header><TextBlock Text="窗口与路径" Foreground="{ThemeResource PageTitleBrush}" /></TabViewItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Padding="0,16,16,16" Spacing="14">
                    <Border Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="按下 X" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="选择关闭窗口时的操作" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" /></StackPanel>
                            <ComboBox x:Name="CloseBehaviorBox" Grid.Column="1" Width="220" VerticalAlignment="Center" AutomationProperties.Name="按下 X 的操作" SelectionChanged="CloseBehaviorBox_OnSelectionChanged">
                                <ComboBoxItem Content="关闭启动器" Tag="Exit" /><ComboBoxItem Content="最小化到托盘" Tag="MinimizeToTray" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource FrostedPanelBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="16"><StackPanel Spacing="8">
                        <TextBlock Text="游戏目录" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="自动查找会在此目录及子目录搜索已知游戏 EXE。未来下载功能将以此为目标目录；当前官网安装器仍需自行选择位置。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="DirectoryBox" AutomationProperties.Name="游戏目录" />
                            <Button Grid.Column="1" Content="浏览…" Click="BrowseDirectory_OnClick" />
                            <Button Grid.Column="2" Content="保存并查找" Style="{StaticResource ThemeActionButtonStyle}" Click="SaveDirectory_OnClick" />
                        </Grid>
                        <TextBlock x:Name="DirectoryResultText" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel></Border>
                    <Border Background="{ThemeResource FrostedPanelBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="16" Padding="16"><StackPanel Spacing="8">
                        <TextBlock Text="启动器数据" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="配置、日志、抽卡记录和壁纸缓存。默认保存在 EXE 旁的 Data 文件夹；更改位置会复制现有数据并重启启动器。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                        <TextBlock Text="{Binding ConfigurationPath}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="DataDirectoryBox" AutomationProperties.Name="启动器数据目录" />
                            <Button Grid.Column="1" Content="浏览…" Click="BrowseDataDirectory_OnClick" />
                            <Button Grid.Column="2" Content="迁移并重启" Style="{StaticResource ThemeActionButtonStyle}" Click="RelocateData_OnClick" />
                        </Grid>
                        <TextBlock x:Name="DataDirectoryResultText" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
