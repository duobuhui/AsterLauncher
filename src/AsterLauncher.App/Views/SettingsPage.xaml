<Page x:Class="AsterLauncher.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AsterLauncher.App.Views">
    <Grid Padding="28,24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <TabView Grid.Row="1" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
            <TabViewItem IsClosable="False" AutomationProperties.Name="首页"><TabViewItem.Header><TextBlock Text="首页" Foreground="{ThemeResource PageTitleBrush}" /></TabViewItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Padding="0,16,16,16" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CommunitySurfaceStyle}" Background="{ThemeResource HeroGlassBrush}" VerticalAlignment="Stretch">
                        <StackPanel Spacing="8"><TextBlock Text="AsterLauncher" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" /><TextBlock Text="独立开发的游戏启动器" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" /><TextBlock x:Name="VersionText" FontSize="14" /><TextBlock Text=".NET 10 · Windows App SDK 2.4 · WinUI 3" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="14">
                        <Border Style="{StaticResource CommunitySurfaceStyle}"><StackPanel Spacing="8"><TextBlock Text="项目主页" Style="{StaticResource SectionHeadingStyle}" /><TextBlock Text="github.com/duobuhui/AsterLauncher" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" /><Button Content="打开 GitHub" Click="OpenRepository_OnClick" /></StackPanel></Border>
                        <Border Style="{StaticResource CommunitySurfaceStyle}"><StackPanel Spacing="8"><TextBlock Text="启动器更新" Style="{StaticResource SectionHeadingStyle}" /><TextBlock x:Name="UpdateStatusText" Text="可从 GitHub Releases 检查新版本" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_OnClick" /><Button x:Name="InstallUpdateButton" Content="下载并安装" IsEnabled="False" Style="{StaticResource ThemeActionButtonStyle}" Click="InstallUpdate_OnClick" /></StackPanel></StackPanel></Border>
                        <Border Style="{StaticResource CommunitySurfaceStyle}"><StackPanel Spacing="8">
                            <TextBlock Text="游戏资料更新" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Text="卡池名称与图片、终末地版本日历与兑换码。来自项目的公开 GitHub 资源目录，独立于启动器更新。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                            <CheckBox x:Name="ResourceUpdatesBox" Content="启动时检查资料更新" Click="ResourceUpdates_OnClick" />
                            <TextBlock x:Name="ResourceStatusText" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                            <Button x:Name="ResourceUpdateButton" Content="更新游戏资料" Click="ResourceUpdate_OnClick" HorizontalAlignment="Left" />
                        </StackPanel></Border>
                    </StackPanel>
                </Grid></ScrollViewer>
            </TabViewItem>
            <TabViewItem IsClosable="False" AutomationProperties.Name="外观"><TabViewItem.Header><TextBlock Text="外观" Foreground="{ThemeResource PageTitleBrush}" /></TabViewItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Padding="0,16,16,16" Spacing="14">
                    <Border Style="{StaticResource CommunitySurfaceStyle}" Background="{ThemeResource HeroGlassBrush}">
                        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="卡片明暗" Style="{StaticResource SectionHeadingStyle}" /><TextBlock Text="独立于主题颜色" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" /></StackPanel>
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="220" VerticalAlignment="Center" AutomationProperties.Name="卡片明暗" SelectionChanged="ThemeBox_OnSelectionChanged">
                                <ComboBoxItem Content="跟随 Windows" Tag="System" /><ComboBoxItem Content="深色" Tag="Dark" /><ComboBoxItem Content="浅色" Tag="Light" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CommunitySurfaceStyle}" Background="{ThemeResource HeroGlassBrush}">
                        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="主题颜色" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="AccentBox" Grid.Column="1" Width="220" AutomationProperties.Name="主题颜色" SelectionChanged="AccentBox_OnSelectionChanged"><ComboBoxItem Content="星芒紫" Tag="Default" /><ComboBoxItem Content="提丰紫" Tag="Purple" /><ComboBoxItem Content="爱莉粉" Tag="Pink" /><ComboBoxItem Content="派蒙白" Tag="Cream" /></ComboBox>
                        </Grid>
                    </Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>
            <TabViewItem IsClosable="False" AutomationProperties.Name="窗口与路径"><TabViewItem.Header><TextBlock Text="窗口与路径" Foreground="{ThemeResource PageTitleBrush}" /></TabViewItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Padding="0,16,16,16" Spacing="14">
                    <Border Style="{StaticResource CommunitySurfaceStyle}" Background="{ThemeResource HeroGlassBrush}">
                        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="按下 X" Style="{StaticResource SectionHeadingStyle}" /><TextBlock Text="选择关闭窗口时的操作" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" /></StackPanel>
                            <ComboBox x:Name="CloseBehaviorBox" Grid.Column="1" Width="220" VerticalAlignment="Center" AutomationProperties.Name="按下 X 的操作" SelectionChanged="CloseBehaviorBox_OnSelectionChanged">
                                <ComboBoxItem Content="关闭启动器" Tag="Exit" /><ComboBoxItem Content="最小化到托盘" Tag="MinimizeToTray" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CommunitySurfaceStyle}"><StackPanel Spacing="8">
                        <TextBlock Text="游戏目录" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="自动查找此目录及子目录中的游戏。新下载的游戏会在此处创建独立的官服和 B 服文件夹。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="DirectoryBox" AutomationProperties.Name="游戏目录" />
                            <Button Grid.Column="1" Content="浏览…" Click="BrowseDirectory_OnClick" />
                            <Button Grid.Column="2" Content="保存并查找" Style="{StaticResource ThemeActionButtonStyle}" Click="SaveDirectory_OnClick" />
                        </Grid>
                        <TextBlock x:Name="DirectoryResultText" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource CommunitySurfaceStyle}"><StackPanel Spacing="8">
                        <TextBlock Text="启动器数据" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="配置、日志、抽卡记录和壁纸缓存。默认保存在 EXE 旁的 Data 文件夹；更改位置会复制现有数据并重启启动器。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                        <TextBlock Text="{Binding ConfigurationPath}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="DataDirectoryBox" AutomationProperties.Name="启动器数据目录" />
                            <Button Grid.Column="1" Content="浏览…" Click="BrowseDataDirectory_OnClick" />
                            <Button Grid.Column="2" Content="迁移并重启" Style="{StaticResource ThemeActionButtonStyle}" Click="RelocateData_OnClick" />
                        </Grid>
                        <TextBlock x:Name="DataDirectoryResultText" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>
            <TabViewItem IsClosable="False" AutomationProperties.Name="本地存储"><TabViewItem.Header><TextBlock Text="本地存储" Foreground="{ThemeResource PageTitleBrush}" /></TabViewItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><views:StorageManagementControl Margin="0,16,16,16" /></ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
