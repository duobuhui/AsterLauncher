<Page
    x:Class="AsterLauncher.App.Views.GachaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:AsterLauncher.Core"
    xmlns:views="using:AsterLauncher.App.Views"
    Loaded="Page_OnLoaded">
    <Page.Resources>
        <views:PoolBannerImageConverter x:Key="PoolBannerImageConverter" />
        <views:HistoryCountVisibilityConverter x:Key="HistoryCountVisibilityConverter" />
        <views:SectionHeaderWidthConverter x:Key="SectionHeaderWidthConverter" />
        <views:PortraitImageConverter x:Key="PortraitImageConverter" />
        <DataTemplate x:Key="SixStarPullTemplate" x:DataType="core:EndfieldSixStarPull">
            <Grid ColumnSpacing="7" MinHeight="40">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="7" Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="✦" FontSize="13" Foreground="{ThemeResource PageTitleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{x:Bind OperatorName, Converter={StaticResource PortraitImageConverter}, ConverterParameter=endfield}" Stretch="Uniform" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind OperatorName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind BarTitle}" FontSize="12" Foreground="{ThemeResource PageTitleBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{x:Bind BarPercent}" Tag="{x:Bind IsOver65}" Loaded="SixStarBar_OnLoaded" HorizontalAlignment="Stretch" Background="#798A9AAB" Foreground="{ThemeResource PageTitleBrush}" ToolTipService.ToolTip="计入保底的抽数，以 80 抽为满格；免费抽不计入。" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="1">
                    <TextBlock Text="{x:Bind RecordedSpanText}" FontSize="12" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind ObtainedAtText}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="UigfPullTemplate" x:DataType="core:UigfHighRarityPull">
            <Grid ColumnSpacing="5" MinHeight="32" Padding="0,1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="25" Height="25" CornerRadius="5" Background="#38475868" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="★" FontSize="12" Foreground="{ThemeResource PageTitleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{x:Bind PortraitKey, Converter={StaticResource PortraitImageConverter}}" Stretch="Uniform" />
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Height="24">
                    <Border Background="#70404D5B" CornerRadius="4" />
                    <Border Background="{ThemeResource PageTitleBrush}" CornerRadius="4" Opacity="0.6" Tag="{x:Bind IsHighCount}" Loaded="UigfFill_OnLoaded" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="{x:Bind BarFraction}" /></Border.RenderTransform>
                    </Border>
                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" Margin="7,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="2" MinWidth="50" Spacing="0" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind PullCountText}" FontSize="12" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind TimeText}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>        <DataTemplate x:Key="UigfBannerTemplate" x:DataType="core:UigfBannerAnalysis">
            <Border Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="10" ToolTipService.ToolTip="{x:Bind PoolTooltip}">
                <Expander Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Padding="11,5" Spacing="2" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind StarNames}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Padding="11,0,11,9" Spacing="5">
                        <TextBlock Text="{x:Bind DateText}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" />
                        <ItemsControl ItemsSource="{x:Bind HighRarityPulls}" ItemTemplate="{StaticResource UigfPullTemplate}" />
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer x:Name="GachaScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" SizeChanged="GachaScrollViewer_OnSizeChanged">
        <StackPanel Padding="24,18" Spacing="10" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="抽卡记录" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentGameText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArchiveSummaryText" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="20" Height="20" VerticalAlignment="Center" IsActive="False" />
                <Button x:Name="CaptureButton" Grid.Column="3" Content="同步记录" Style="{StaticResource AccentButtonStyle}" Click="Capture_OnClick" VerticalAlignment="Center" />
                <Button x:Name="FullCaptureButton" Grid.Column="4" Content="全量同步" Click="FullCapture_OnClick" VerticalAlignment="Center" Visibility="Collapsed" Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" />
            </Grid>

            <Grid x:Name="EndfieldPityStrip" ColumnSpacing="8" Visibility="Collapsed" ToolTipService.ToolTip="按本地记录估算；缺失的历史记录会影响计数，免费抽不计入保底。">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                    <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="常驻已垫" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StandardPityText" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                    <Grid ColumnSpacing="6" RowSpacing="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="LimitedPityLabel" Text="小保底已垫" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="LimitedPityText" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" />
                        <ProgressBar x:Name="LimitedPityBar" Grid.Row="1" Grid.ColumnSpan="2" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="{ThemeResource PageTitleBrush}" Background="#798A9AAB" ToolTipService.ToolTip="按当前寻访类型累计 80 抽六星保底；重构池之间共用，免费十连不计入。" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                    <Grid ColumnSpacing="6" RowSpacing="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="UpRemainingLabel" Text="UP池剩余" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="UpRemainingText" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" />
                        <ProgressBar x:Name="UpPityBar" Grid.Row="1" Grid.ColumnSpan="2" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="{ThemeResource PageTitleBrush}" Background="#798A9AAB" ToolTipService.ToolTip="同名重构池的首次 120 抽 UP 保底跨期继承，仅触发一次；免费十连不计入。" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <InfoBar x:Name="ResultInfo" IsOpen="False" IsClosable="True" />

            <StackPanel x:Name="EndfieldAnalysisPanel" Visibility="Collapsed" Spacing="8">
                <TextBlock x:Name="SixStarEmptyText" Text="暂无终末地寻访记录" Foreground="{ThemeResource GlassMutedTextBrush}" Visibility="Collapsed" />
                <ItemsRepeater x:Name="HistoryPoolItems" Visibility="Collapsed">
                    <ItemsRepeater.Layout><StackLayout Spacing="10" /></ItemsRepeater.Layout>
                </ItemsRepeater>
                <ItemsRepeater x:Name="PoolItems">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="core:EndfieldPoolAnalysis">
                            <Border BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="13" Padding="1">
                                <Grid>
                                    <Border CornerRadius="12" Opacity="0.94" Height="76" VerticalAlignment="Top">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill" ImageSource="{x:Bind BannerAssetFileName, Converter={StaticResource PoolBannerImageConverter}}" />
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#C3162534" Offset="0" />
                                                <GradientStop Color="#DD162534" Offset="0.5" />
                                                <GradientStop Color="#F2162534" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <Expander Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <StackPanel Padding="10,6" Spacing="3" HorizontalAlignment="Stretch">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind PoolName}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind OperatorSummary}" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                                                    <TextBlock Text="{x:Bind DetailText}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Padding="10,0,10,10" Spacing="7" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                                                <ItemsControl ItemsSource="{x:Bind SixStarPulls}" ItemTemplate="{StaticResource SixStarPullTemplate}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind PreviousPhaseCount, Converter={StaticResource HistoryCountVisibilityConverter}}">
                                            <Expander.Header>
                                                <TextBlock Text="{x:Bind PreviousPhaseLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" Margin="12,1,0,1" />
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{x:Bind PreviousPhases}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="core:EndfieldPoolAnalysis">
                                                        <Border Margin="10,0,10,8" Padding="10,7" Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="9">
                                                            <StackPanel Spacing="4">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{x:Bind PoolName}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" />
                                                                </Grid>
                                                                <TextBlock Text="{x:Bind OperatorSummary}" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                                                                <TextBlock Text="{x:Bind DetailText}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                <ItemsControl ItemsSource="{x:Bind SixStarPulls}" ItemTemplate="{StaticResource SixStarPullTemplate}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Grid x:Name="PoolColumns" ColumnSpacing="10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ItemsRepeater x:Name="PoolLeftItems">
                        <ItemsRepeater.Layout><StackLayout Spacing="10" /></ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ItemsRepeater x:Name="PoolRightItems" Grid.Column="1">
                        <ItemsRepeater.Layout><StackLayout Spacing="10" /></ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>
            </StackPanel>

            <ItemsRepeater x:Name="UigfPityStrip" Visibility="Collapsed">
                <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="155" MinColumnSpacing="8" MinRowSpacing="5" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="core:UigfPityIndicator">
                        <Border Background="{ThemeResource HeroGlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="10,5">
                            <StackPanel Spacing="2"><Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Text}" Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" />
                            </Grid><ProgressBar Value="{x:Bind Percent}" Tag="{x:Bind IsHighCount}" Loaded="SixStarBar_OnLoaded" Height="4" Maximum="100" Background="#798A9AAB" Foreground="{ThemeResource PageTitleBrush}" /></StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <StackPanel x:Name="UigfAnalysisPanel" Visibility="Collapsed" Spacing="7" SizeChanged="UigfAnalysisPanel_OnSizeChanged">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="UigfRulesText" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="UigfAccountSelector" Grid.Column="1" MinWidth="150" Visibility="Collapsed" SelectionChanged="UigfAccountSelector_SelectionChanged" />
                </Grid>
                <TextBlock x:Name="UigfEmptyText" Text="暂无星穹铁道记录；同步或导入 UIGF 后显示。" FontSize="13" Foreground="{ThemeResource GlassMutedTextBrush}" Visibility="Collapsed" />
                <ItemsRepeater x:Name="UigfSections">
                    <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="core:UigfPoolSection">
                            <Border x:Name="UigfSectionBorder" Background="{ThemeResource FrostedPanelBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="11,8">
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PageTitleBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DateRange}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind CountText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnSpacing="12" RowSpacing="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="{x:Bind HighRarityStat}" FontSize="12" Foreground="#FFFFBA49" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind MiddleRarityStat}" FontSize="12" Foreground="#FFE29AF4" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind LowRarityStat}" FontSize="12" Foreground="#FF8FC9F8" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind AverageText}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" />
                                    </Grid>
                                    <ItemsRepeater ItemsSource="{x:Bind HighRarityPulls}" ItemTemplate="{StaticResource UigfPullTemplate}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="210" MinColumnSpacing="9" MinRowSpacing="3" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                    <Expander Background="Transparent" Visibility="{x:Bind PreviousBannerCount, Converter={StaticResource HistoryCountVisibilityConverter}}" HorizontalContentAlignment="Stretch">
                                        <Expander.Header><Grid Width="{Binding ActualWidth, ElementName=UigfSectionBorder, Converter={StaticResource SectionHeaderWidthConverter}}"><TextBlock Text="{x:Bind BreakdownLabel}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" /></Grid></Expander.Header>
                                        <ItemsControl ItemsSource="{x:Bind Banners}" ItemTemplate="{StaticResource UigfBannerTemplate}" HorizontalContentAlignment="Stretch">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Grid x:Name="UigfColumns" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ItemsRepeater x:Name="UigfRoleSections">
                        <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ItemsRepeater x:Name="UigfOtherSections" Grid.Column="1">
                        <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>
            </StackPanel>
            <Border Background="{ThemeResource FrostedPanelBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="ImportButton" Content="导入 UIGF v4 JSON" Click="Import_OnClick" />
                    <Button x:Name="ExportButton" Content="导出 UIGF v4.2 JSON" Click="Export_OnClick" />
                    <Button x:Name="ExportCsvButton" Content="导出 CSV" Visibility="Collapsed" Click="ExportCsv_OnClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
